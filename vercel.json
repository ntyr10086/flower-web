{
  "buildCommand": "echo 'Static build complete'",
  "framework": "static",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*).html",
      "destination": "/$1"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/pages/$1.html"
    }
  ]
}
